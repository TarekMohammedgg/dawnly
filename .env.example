# Dawnly environment variables
# Copy to `.env.local` for local development. Never commit secrets.

# Public (safe in Vite client / Vercel public env)
VITE_DAWNLY_PUBLIC_URL=https://YOUR_DAWNLY_DOMAIN.vercel.app
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (Vercel env, not prefixed with VITE_)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
DAWNLY_PIN_HASH=scrypt$16384$8$1$...
DAWNLY_SESSION_SECRET=generate-a-long-random-string
DAWNLY_CRON_SECRET=generate-a-different-long-random-string

# Optional bootstrap only — prefer Settings → Vault for live keys
# OPENROUTER_API_KEY=sk-or-...
# MINIMAX_API_KEY=sk-cp-...

# Optional legacy aliases (also accepted by the server):
# SUPABASE_SERVICE_ROLE_KEY=...
